# The homework bot's settings. On the server: /etc/homework-bot.env, readable by root only.

# From @BotFather in Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# Who may send photos: her Telegram user ID and yours, comma-separated. Left empty, the bot
# ignores everyone and logs each sender's ID (journalctl -u homework-bot), which is how you find them.
ALLOWED_USER_IDS=

# Your Telegram user ID: you get a note for every problem added, and the details when one fails.
PARENT_CHAT_ID=

# From `claude setup-token`, run on a machine logged in to your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=

# Netlify: User settings → Applications → Personal access tokens.
NETLIFY_AUTH_TOKEN=

# The day a problem was sent, in your time zone (the server's is usually UTC).
TZ=Europe/Kyiv

# 1 for a first try: each problem is written and checked, but nothing is saved or published.
DRY_RUN=0

# Optional:
# REPO_DIR=/home/homework/math        (default: the clone this bot is in)
# DATA_DIR=/home/homework/.homework-bot  (photos, queue, Claude Code's answers)
# CLAUDE_MODEL=                       (default: your subscription's default model)
